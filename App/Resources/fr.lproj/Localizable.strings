/*
 * Localizable.strings (French)
 *
 * Mirrors en.lproj/Localizable.strings key for key — `make build` fails on any
 * divergence. Read the English file's header before editing; it documents the
 * format-specifier rules.
 *
 * French typography, applied throughout:
 *   - \U00A0 (non-breaking space) before : ; ! ? and inside « … »
 *   - typographic apostrophe ’ rather than '
 *   - "Espace" is capitalized as the name of the macOS feature, matching the
 *     English source; "changement" is the word used for a switch between them
 */

/* Product name. Do not translate; transliterate only where the script requires it. */
"app.name" = "Space Rabbit";


/* --- Shared button titles and labels ------------------------------------ */

"common.ok" = "OK";
"common.cancel" = "Annuler";
"common.later" = "Plus tard";
"common.tryAgain" = "Réessayer";

/* %@ is a version number, e.g. "1.4.0" */
"common.version" = "Version %@";


/* --- Menu bar dropdown -------------------------------------------------- */

/* Feature toggles. The trailing glyphs are the macOS shortcut they replace
   (Control + left/right arrow, and Command + Tab) — keep them as-is. */
"menu.instantSpaceSwitch" = "Changement d’Espace instantané ⌃↔";
"menu.instantAppSwitch" = "Changement d’app instantané ⌘⇥";

/* Feature 3 toggle: replaces the animated trackpad swipe (3 or 4 fingers).
   No trailing glyph — the gesture it replaces has no keyboard shortcut. */
"menu.instantTrackpadSwipe" = "Balayage instantané du trackpad";
"menu.instantMissionControl" = "Mission Control instantané";

/* Small grey section headings */
"menu.section.configure" = "Configurer\U00A0:";
"menu.section.statistics" = "Statistiques\U00A0:";

"menu.preferences" = "Préférences…";
"menu.quit" = "Quitter Space Rabbit";

/* Warning banner shown when the app is not registered as a login item */
"menu.banner.notAutoLaunching" = "Lancement auto désactivé";
"menu.banner.clickToFix" = "Cliquez pour corriger";

/* Call to action on the update banner (its heading is update.available.title) */
"menu.banner.clickToInstall" = "Cliquez pour installer";

/* Statistics row. %1$@ is a switch count with its unit ("1 204 changements",
   from stats.switches), %2$@ a duration ("20 min", system-formatted).
   The participle stays invariable: the duration's gender is unknown here
   ("20 min" is feminine, "3 jours" masculine). */
"menu.stats.line" = "%1$@  ·  %2$@ économisé";


/* --- Settings window ---------------------------------------------------- */

"settings.window.title" = "Préférences de Space Rabbit";

/* Sidebar rows, also used as the heading of the pane they select. Kept short:
   the sidebar is a fixed 165 pt and truncates with an ellipsis. */
"settings.pane.autoStart" = "Démarrage";
"settings.pane.features" = "Fonctionnalités";
"settings.pane.advanced" = "Avancé";
"settings.pane.updates" = "Mises à jour";
"settings.pane.about" = "À propos";


