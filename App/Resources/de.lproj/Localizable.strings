/*
 * Localizable.strings (German)
 *
 * Mirrors en.lproj/Localizable.strings key for key — `make build` fails on any
 * divergence. Read the English file's header before editing; it documents the
 * format-specifier rules.
 *
 * Covers de-DE, de-AT and de-CH, which macOS all resolves to this table.
 * German typography: „…“ for quotation marks. "Space" is left untranslated as
 * the name of the macOS feature, matching Apple's own German wording.
 */

/* Product name. Do not translate; transliterate only where the script requires it. */
"app.name" = "Space Rabbit";


/* --- Shared button titles and labels ------------------------------------ */

"common.ok" = "OK";
"common.cancel" = "Abbrechen";
"common.later" = "Später";
"common.tryAgain" = "Erneut versuchen";

/* %@ is a version number, e.g. "1.4.0" */
"common.version" = "Version %@";


/* --- Menu bar dropdown -------------------------------------------------- */

/* Feature toggles. The trailing glyphs are the macOS shortcut they replace
   (Control + left/right arrow, and Command + Tab) — keep them as-is. */
"menu.instantSpaceSwitch" = "Sofortiger Space-Wechsel ⌃↔";
"menu.instantAppSwitch" = "Sofortiger App-Wechsel ⌘⇥";

/* Feature 3 toggle: replaces the animated 3-finger trackpad swipe.
   No trailing glyph — the gesture it replaces has no keyboard shortcut. */
"menu.instantThreeFingerSwipe" = "Sofortiges 3-Finger-Streichen";

/* Small grey section headings */
"menu.section.configure" = "Konfigurieren:";
"menu.section.statistics" = "Statistik:";

"menu.preferences" = "Einstellungen…";
"menu.quit" = "Space Rabbit beenden";

/* Warning banner shown when the app is not registered as a login item */
"menu.banner.notAutoLaunching" = "Kein automatischer Start";
"menu.banner.clickToFix" = "Zum Beheben klicken";

/* Call to action on the update banner (its heading is update.available.title) */
"menu.banner.clickToInstall" = "Zum Installieren klicken";

/* Statistics row. %1$@ is a switch count with its unit ("1.204 Wechsel", from
   stats.switches), %2$@ a duration ("20 Min.", system-formatted). */
"menu.stats.line" = "%1$@  ·  %2$@ gespart";


/* --- Settings window ---------------------------------------------------- */

"settings.window.title" = "Space Rabbit-Einstellungen";

/* Sidebar rows, also used as the heading of the pane they select. Kept short:
