"settings.pane.features" = "Funktionen";
"settings.pane.advanced" = "Erweitert";
"settings.pane.updates" = "Updates";
"settings.pane.about" = "Über";


/* --- Settings · Auto-Start ---------------------------------------------- */

"settings.autoStart.launchAtLogin" = "Beim Anmelden öffnen";

/* Orange banner. The quoted part must match settings.autoStart.launchAtLogin. */
"settings.autoStart.warning" = "Space Rabbit ist nicht so eingestellt, dass es beim Anmelden öffnet. Aktiviere unten „Beim Anmelden öffnen“, damit es automatisch startet.";

"settings.autoStart.approvalNeeded" = "Bestätigung erforderlich – prüfe die Anmeldeobjekte in den Systemeinstellungen.";

