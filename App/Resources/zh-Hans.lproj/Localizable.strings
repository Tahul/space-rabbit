/*
 * Localizable.strings (Simplified Chinese)
 *
 * Mirrors en.lproj/Localizable.strings key for key — `make build` fails on any
 * divergence. Read the English file's header before editing; it documents the
 * format-specifier rules.
 *
 * "zh-Hans" is Apple's script-based code and the right one here: macOS resolves
 * zh-Hans-CN, zh-CN and bare zh to this table, while Traditional Chinese
 * (zh-Hant-TW, zh-HK) correctly does NOT match and falls back to English until
 * a zh-Hant.lproj exists. The legacy zh_CN naming would also work but does not
 * express the Simplified/Traditional distinction.
 *
 * Typography: fullwidth punctuation (：“”) and no space before a colon. Chinese
 * needs no space between the number and its measure word.
 */

/* Product name. Do not translate; transliterate only where the script requires it. */
"app.name" = "Space Rabbit";


/* --- Shared button titles and labels ------------------------------------ */

/* Apple's Chinese UI uses 好 rather than OK for confirmation buttons */
"common.ok" = "好";
"common.cancel" = "取消";
