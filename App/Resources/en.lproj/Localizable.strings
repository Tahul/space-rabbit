/*
 * Localizable.strings (English) — reference table for every other language.
 *
 * English is the development language: it defines which keys exist. Adding,
 * renaming or removing a key here REQUIRES the same change in every other
 * <lang>.lproj/Localizable.strings, or `make build` fails.
 *
 * Format specifiers must survive translation. `%@` and `%d` may be reordered
 * with positional forms (`%1$@`, `%2$@`) when the target language needs a
 * different word order, but the set of specifiers has to match this file.
 *
 * Plural-sensitive strings do not belong here — they live in
 * Localizable.stringsdict.
 */

/* Product name. Do not translate; transliterate only where the script requires it. */
"app.name" = "Space Rabbit";


/* --- Shared button titles and labels ------------------------------------ */

"common.ok" = "OK";
"common.cancel" = "Cancel";
"common.later" = "Later";
"common.tryAgain" = "Try Again";

/* %@ is a version number, e.g. "1.4.0" */
"common.version" = "Version %@";


/* --- Menu bar dropdown -------------------------------------------------- */

/* Feature toggles. The trailing glyphs are the macOS shortcut they replace
   (Control + left/right arrow, and Command + Tab) — keep them as-is. */
"menu.instantSpaceSwitch" = "Instant Space Switch ⌃↔";
"menu.instantAppSwitch" = "Instant App Switch ⌘⇥";

/* Feature 3 toggle: replaces the animated trackpad swipe (3 or 4 fingers).
   No trailing glyph — the gesture it replaces has no keyboard shortcut. */
"menu.instantTrackpadSwipe" = "Instant Trackpad Swipe";

/* Small grey section headings */
"menu.section.configure" = "Configure:";
"menu.section.statistics" = "Statistics:";

"menu.preferences" = "Preferences…";
"menu.quit" = "Quit Space Rabbit";

/* Warning banner shown when the app is not registered as a login item */
"menu.banner.notAutoLaunching" = "Not Auto-Launching";
"menu.banner.clickToFix" = "Click to Fix";

/* Call to action on the update banner (its heading is update.available.title) */
"menu.banner.clickToInstall" = "Click to Install";

/* Statistics row. %1$@ is a switch count with its unit ("1,204 switches",
   from stats.switches), %2$@ a duration ("20 min", system-formatted). */
"menu.stats.line" = "%1$@  ·  %2$@ saved";


