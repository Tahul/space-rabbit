<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Localizable.stringsdict (Portuguese) — plural-sensitive strings.

  Portuguese declares one/many/other in CLDR. Only one/other are supplied:
  "many" applies to compactly-written large numbers, which this app never
  produces, and an absent category falls back to "other".

  Arguments, as in en.lproj: %1$… is the raw count selecting the plural
  category, %2$@ that count formatted for the locale ("1.204") for display.
-->
<plist version="1.0">
<dict>
    <key>stats.switches</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@switches@</string>
        <key>switches</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%2$@ mudança</string>
            <key>other</key>
            <string>%2$@ mudanças</string>
        </dict>
    </dict>
</dict>
</plist>
