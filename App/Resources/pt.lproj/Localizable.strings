/*
 * Localizable.strings (Portuguese)
 *
 * Mirrors en.lproj/Localizable.strings key for key — `make build` fails on any
 * divergence. Read the English file's header before editing; it documents the
 * format-specifier rules.
 *
 * Bare "pt" deliberately: macOS resolves BOTH pt-BR and pt-PT to this table, so
 * the wording avoids the terms where the two variants diverge most. If the
 * variants ever need to differ, split this into pt-BR.lproj and pt-PT.lproj —
 * the more specific table then wins for its region.
 */

/* Product name. Do not translate; transliterate only where the script requires it. */
"app.name" = "Space Rabbit";


/* --- Shared button titles and labels ------------------------------------ */

"common.ok" = "OK";
"common.cancel" = "Cancelar";
"common.later" = "Mais tarde";
"common.tryAgain" = "Tentar novamente";

/* %@ is a version number, e.g. "1.4.0" */
"common.version" = "Versão %@";


/* --- Menu bar dropdown -------------------------------------------------- */

/* Feature toggles. The trailing glyphs are the macOS shortcut they replace
   (Control + left/right arrow, and Command + Tab) — keep them as-is. */
"menu.instantSpaceSwitch" = "Mudança de espaço instantânea ⌃↔";
"menu.instantAppSwitch" = "Mudança de app instantânea ⌘⇥";

/* Feature 3 toggle: replaces the animated 3-finger trackpad swipe.
   No trailing glyph — the gesture it replaces has no keyboard shortcut. */
"menu.instantThreeFingerSwipe" = "Deslize com 3 dedos instantâneo";

/* Small grey section headings */
"menu.section.configure" = "Configurar:";
"menu.section.statistics" = "Estatísticas:";

"menu.preferences" = "Preferências…";
"menu.quit" = "Sair do Space Rabbit";

/* Warning banner shown when the app is not registered as a login item */
"menu.banner.notAutoLaunching" = "Não abre automaticamente";
"menu.banner.clickToFix" = "Clique para corrigir";

/* Call to action on the update banner (its heading is update.available.title) */
"menu.banner.clickToInstall" = "Clique para instalar";

/* Statistics row. %1$@ is a switch count with its unit ("1.204 mudanças", from
   stats.switches), %2$@ a duration ("20 min", system-formatted). Phrased as a
   noun ("de economia") to avoid agreeing with the duration, whose gender and
   number are not knowable here. */
"menu.stats.line" = "%1$@  ·  %2$@ de economia";


/* --- Settings window ---------------------------------------------------- */

"settings.window.title" = "Preferências do Space Rabbit";

/* Sidebar rows, also used as the heading of the pane they select. Kept short:
   the sidebar is a fixed 165 pt and truncates with an ellipsis. */
"settings.pane.autoStart" = "Início auto.";
"settings.pane.features" = "Funções";
"settings.pane.advanced" = "Avançado";
"settings.pane.updates" = "Atualizações";
"settings.pane.about" = "Sobre";


/* --- Settings · Auto-Start ---------------------------------------------- */

"settings.autoStart.launchAtLogin" = "Abrir ao iniciar sessão";

/* Orange banner. The quoted part must match settings.autoStart.launchAtLogin. */
"settings.autoStart.warning" = "O Space Rabbit não está configurado para abrir ao iniciar sessão. Ative “Abrir ao iniciar sessão” abaixo para que ele inicie automaticamente.";

"settings.autoStart.approvalNeeded" = "Autorização necessária: verifique os itens de início nos Ajustes do Sistema.";

/* %@ is a system error message, itself localized by macOS */
"settings.autoStart.error" = "Não foi possível atualizar o item de início: %@";


/* --- Settings · Features ------------------------------------------------ */

"settings.features.instantSpaceSwitch" = "Mudança de espaço instantânea";
"settings.features.instantAppSwitch" = "Mudança de app instantânea";
"settings.features.instantThreeFingerSwipe" = "Deslize com 3 dedos instantâneo";
"settings.features.transitionSpeed" = "Velocidade da transição";

/* Transition-speed slider ticks, slowest to fastest. "Normal" is macOS's own
   animation (Space Rabbit stands down); "Instant" is the no-animation end.
   Feminine, agreeing with "velocidade". */
"settings.features.speed.normal" = "Normal";
"settings.features.speed.fast" = "Rápida";
"settings.features.speed.faster" = "Mais rápida";
"settings.features.speed.fastest" = "Muito rápida";
"settings.features.speed.instant" = "Instantânea";


/* --- Settings · Advanced ------------------------------------------------ */

"settings.advanced.instantDockHide" = "Ocultar o Dock instantaneamente";
"settings.advanced.dockSubtitle" = "Isto altera um ajuste global do macOS.";
"settings.advanced.resetToDefault" = "Restaurar o valor padrão";

"settings.advanced.showMenuBarIcon" = "Mostrar o ícone na barra de menus";

/* Subtitle under the menu bar icon toggle: what turning it off will do, and
